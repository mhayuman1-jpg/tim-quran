# ========================
# Tim Qur'an — Root .gitignore
# ========================

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/

# Capacitor web assets (generated from web build)
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files — keep .env.example but ignore actual .env
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# kiro
.kiro/

# ========================
# Android specific (root level)
# ========================
local.properties

# keystore — NEVER commit secrets
*.keystore
*.jks

# build logs
build.log

# Local Netlify folder
.netlify

.vercel

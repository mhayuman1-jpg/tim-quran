# ========================
# Tim Qur'an — Android .gitignore
# ========================
# Based on: https://github.com/github/gitignore/blob/main/Android.gitignore

# --- Build outputs ---
*.apk
*.aar
*.ap_
*.aab
*.dex
*.class

bin/
gen/
out/
build/
.gradle/
local.properties

# --- IDE ---
*.iml
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
.idea/caches
.idea/modules.xml
.idea/navEditor.xml
.navigation/
captures/

# --- Proguard ---
proguard/

# --- Logs ---
*.log

# --- Keystore & secrets — NEVER commit ---
*.jks
*.keystore

# --- Android Studio native ---
.externalNativeBuild
.cxx/

# --- Google Services ---
# google-services.json

# --- Profiling ---
*.hprof

# --- Cordova / Capacitor generated ---
capacitor-cordova-android-plugins

# Copied web assets (generated by npx cap copy)
app/src/main/assets/public

# Generated Config files (regenerated each npx cap sync)
app/src/main/assets/capacitor.config.json
app/src/main/assets/capacitor.plugins.json
app/src/main/res/xml/config.xml

# --- Version control ---
vcs.xml

# --- lint ---
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/

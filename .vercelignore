# ========================
# .vercelignore — exclude non-web files from deployment
# ========================

# Android — not needed for Vercel (Next.js hosting)
android/
*.keystore
*.jks

# Audio / assets not used on web
public/audio/

# Build logs / docs
build.log
*.md

# Capacitor config (mobile-only)
capacitor.config.ts
capacitor.config.json

# IDE / local
.vscode/
.idea/
*.local
